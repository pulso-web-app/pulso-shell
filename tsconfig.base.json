{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@pulso-shell/auth-data-access": ["./libs/auth/data-access/src/index.ts"],
      "@pulso-shell/auth-feature": ["./libs/auth/feature/src/index.ts"],
      "@pulso-shell/shell-feature": ["./libs/shell/feature/src/index.ts"],
      "@pulso-shell/shared-ui": ["./libs/shared/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
